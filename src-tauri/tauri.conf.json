{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crocodile Gena Studio",
  "version": "5.1.0",
  "identifier": "studio.crocodilegena.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Crocodile Gena Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "backgroundColor": "#07090e",
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Premium Steam and EOS utility workspace",
    "icon": ["icon.ico"],
    "resources": {
      "../backend/core_engine/": "backend/core_engine/",
      "../CreamAPI/steam_api.dll": "CreamAPI/steam_api.dll",
      "../CreamAPI/steam_api64.dll": "CreamAPI/steam_api64.dll"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
